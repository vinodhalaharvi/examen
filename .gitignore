# Binaries
bin/
*.exe
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.txt

# Editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp

# Environment / secrets
.env
.env.local

# Optional: keep the question bank out of version control if you want
# data/bank.json
# data/examen.db

# SQLite WAL/SHM files (always exclude — runtime artifacts)
*.db-wal
*.db-shm

# SQLite runtime artifacts (regenerated on every open)
data/*.db-wal
data/*.db-shm

# Backups (local-only)
data/*.db.bak
